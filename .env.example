# ─────────────────────────────────────────────────────────────
# YawaReleaseBot — Environment Variables
# Скопируйте этот файл в `.env` и отредактируйте при необходимости.
# ─────────────────────────────────────────────────────────────

# Путь к файлу встроенной базы данных SQLite.
# Если не задан — используется ./data/yawareleasebot.db
# (приложение создаёт файл и таблицы автоматически, PostgreSQL не нужен).
DB_FILE=./data/yawareleasebot.db
